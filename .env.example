# ---------------------------------------------------------------------------
# Aviator Predictor — environment configuration
# Copy this file to `.env.local` and fill in your own values.
# `.env.local` is git-ignored and must NEVER be committed.
# ---------------------------------------------------------------------------

# --- Security ---------------------------------------------------------------
# Secret used to sign session cookies / CSRF tokens.
# REQUIRED in production — replace the placeholder below. A missing, too-short
# or still-placeholder value is detected at boot: the server logs a
# CONFIGURATION ERROR and disables sign-in (503) instead of crashing pages.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET=replace-me-with-a-long-random-string-at-least-32-chars

# Session lifetime in hours (default: 168 = 7 days)
SESSION_TTL_HOURS=168

# Rate-limit ceilings (optional, defaults shown)
LOGIN_RATE_LIMIT=8
REGISTER_RATE_LIMIT=5

# --- Storage ----------------------------------------------------------------
# local  -> JSON files inside ./data  (development / self-hosted single node)
# Any other value requires a persistent driver to be registered in
# lib/storage/drivers.ts before boot. Unconfigured remote modes fail loudly
# instead of silently discarding writes.
STORAGE_MODE=local

# Base directory for file storage (relative paths resolve from the project root)
DATA_DIR=data
STORAGE_DIR=storage

# --- Bootstrap administrator ------------------------------------------------
# Quote the password: dotenv treats an unquoted "#" as the start of a comment.
# Used by `npm run seed` / `npm run seed:demo` to create the first admin.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD="change-this-password"
ADMIN_FULL_NAME=Platform Administrator
ADMIN_USERNAME=admin

# --- Aviator live data provider ---------------------------------------------
# Point this at an AUTHORISED Aviator data source you are permitted to use.
# Leave it empty and the app shows a clear "provider not configured" state —
# it never invents game results.
AVIATOR_PROVIDER_URL=
AVIATOR_PROVIDER_KEY=
# Optional extra headers as JSON, e.g. '{"X-Tenant":"acme"}'
AVIATOR_PROVIDER_HEADERS=
# Provider request timeout in ms (default 4000)
AVIATOR_PROVIDER_TIMEOUT_MS=4000
# How long a snapshot is cached server-side in ms (default 1000)
AVIATOR_CACHE_TTL_MS=1000

# --- Local simulation (DEVELOPMENT ONLY) ------------------------------------
# When no real provider is configured, this renders an explicitly labelled
# SIMULATED feed so the UI can be explored offline. Every screen shows a
# "simulated" badge and predictions refuse to use simulated data unless the
# flag below is enabled. Keep both false in production.
AVIATOR_ALLOW_SIMULATION=false
AVIATOR_PREDICTIONS_ALLOW_SIMULATED=false

# --- Demo data --------------------------------------------------------------
# Seeds example users/payments on boot (local development only).
DEMO_SEED=false
